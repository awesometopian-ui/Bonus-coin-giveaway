<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { pageTitle: 'Rewards — ' + settings.siteName }) %>
<body>
  <div class="wrap">
    <%- include('partials/site-header') %>

    <% if (!activeGiveaway) { %>
      <div class="panel empty-state">
        <h2 class="panel-title">No reward is live right now</h2>
        <p>Check back soon, or watch the announcement channel for the next giveaway.</p>
      </div>
    <% } else { %>
      <section class="panel">
        <div class="eyebrow">Current reward</div>
        <h1 class="panel-title"><%= activeGiveaway.title %></h1>
        <% if (activeGiveaway.description) { %>
          <p><%= activeGiveaway.description %></p>
        <% } %>

        <% var hasErrors = errors && Object.keys(errors).length > 0; %>
        <button
          type="button"
          id="reveal-claim-btn"
          class="btn btn-primary <%= hasErrors ? 'hidden' : '' %>"
        >
          Claim reward
        </button>

        <div
          id="claim-form-section"
          class="<%= hasErrors ? '' : 'hidden' %>"
          data-force-open="<%= hasErrors ? 'true' : 'false' %>"
        >
          <% if (fields.length === 0) { %>
            <p style="margin-top: 20px;">This giveaway isn't ready to accept entries yet.</p>
          <% } else { %>
            <form method="POST" action="/rewards/claim" novalidate style="margin-top: 20px;">
              <% fields.forEach(function(field) { %>
                <div class="field">
                  <label for="field-<%= field.id %>">
                    <%= field.label %><% if (field.required) { %><span class="required-mark">*</span><% } %>
                  </label>
                  <div class="field-input-row">
                    <input
                      type="text"
                      id="field-<%= field.id %>"
                      name="<%= field.id %>"
                      placeholder="<%= field.placeholder %>"
                      value="<%= formValues && formValues[field.id] ? formValues[field.id] : '' %>"
                      <%= field.required ? 'required' : '' %>
                    />
                    <% if (field.copyable) { %>
                      <button type="button" class="copy-btn" data-copy-target="field-<%= field.id %>">Copy</button>
                    <% } %>
                  </div>
                  <% if (errors && errors[field.id]) { %>
                    <div class="field-error"><%= errors[field.id] %></div>
                  <% } %>
                </div>
              <% }); %>

              <div class="notice">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 2L4 5V11C4 16 7.4 20.4 12 22C16.6 20.4 20 16 20 11V5L12 2Z" stroke="#1B5E52" stroke-width="1.6" stroke-linejoin="round"/>
                  <path d="M9.5 12L11.2 13.7L14.7 10" stroke="#1B5E52" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Your submitted information is secured and will not be publicly displayed. Only the giveaway administrator can view it.</span>
              </div>

              <button type="submit" class="btn btn-primary">Submit entry</button>
            </form>
          <% } %>
        </div>
      </section>
    <% } %>

    <%- include('partials/site-footer') %>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
