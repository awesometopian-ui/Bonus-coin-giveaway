<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { pageTitle: 'Entry status — ' + settings.siteName }) %>

<body>
  <div class="wrap">

    <%- include('partials/site-header') %>

    <section class="panel" style="text-align:center;">

      <% if (status === 'winner') { %>

        <div class="confirm-icon">
          <svg width="52" height="52" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="11" fill="rgba(47,143,91,0.12)"/>
            <path d="M7 12.5L10.2 15.7L17 8.5"
              stroke="#2f8f5b"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"/>
          </svg>
        </div>

        <h1 class="panel-title">Successful 🎉</h1>

      <% } else if (status === 'declined') { %>

        <div class="confirm-icon">
          <svg width="52" height="52" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="11" fill="rgba(220,53,69,0.12)"/>
            <path d="M8 8L16 16M16 8L8 16"
              stroke="#dc3545"
              stroke-width="2"
              stroke-linecap="round"/>
          </svg>
        </div>

        <h1 class="panel-title">Not selected</h1>

      <% } else { %>

        <div class="confirm-icon">
          <svg width="52" height="52" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="11" fill="rgba(245,158,11,0.12)"/>
            <path d="M12 7V13"
              stroke="#f59e0b"
              stroke-width="2"
              stroke-linecap="round"/>
            <circle cx="12" cy="17" r="1"
              fill="#f59e0b"/>
          </svg>
        </div>

        <h1 class="panel-title">Submission received</h1>

      <% } %>


      <p>
        Your submission for
        <strong><%= giveawayTitle %></strong>
        was received.
      </p>


      <% if (message) { %>

        <div class="notice" style="margin-top:22px; text-align:left;">
          <span>
            <%= message %>
          </span>
        </div>

      <% } %>


      <% if (submittedFields && submittedFields.length > 0) { %>

        <div style="text-align:left; margin-top:20px;">

          <% submittedFields.forEach(function(f, i) { %>

            <div class="value-row">

              <span class="label">
                <%= f.label %>
              </span>

              <span
                class="value"
                id="confirm-value-<%= i %>"
              >
                <%= f.value %>
              </span>

            </div>

          <% }); %>

        </div>

      <% } %>


      <div
        class="notice"
        style="margin-top:22px; text-align:left;"
      >

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M12 2L4 5V11C4 16 7.4 20.4 12 22C16.6 20.4 20 16 20 11V5L12 2Z"
            stroke="#1B5E52"
            stroke-width="1.6"
            stroke-linejoin="round"
          />

          <path
            d="M9.5 12L11.2 13.7L14.7 10"
            stroke="#1B5E52"
            stroke-width="1.6"
            stroke-linecap="round"
          />

        </svg>

        <span>
          Your submitted information is secured and will not be publicly displayed.
        </span>

      </div>


      <a
        class="btn btn-secondary"
        href="/"
        style="margin-top:8px;"
      >
        Back to home
      </a>

    </section>


    <%- include('partials/site-footer') %>

  </div>
</body>
</html>
