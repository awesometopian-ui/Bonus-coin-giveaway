<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head', { pageTitle: 'Admin Login' }) %>

<body class="admin-body admin-body-center">

  <div class="admin-login-wrap">

    <div class="admin-login-brand">
      <%- include('../partials/coin-mark', { size: 48 }) %>
      <div>Bonus Coin Giveaway</div>
    </div>

    <div class="panel">

      <span class="eyebrow">ADMIN AREA</span>

      <h1 class="panel-title">Admin Access</h1>

      <p style="margin-top:-2px; margin-bottom:24px;">
        Enter the administrator PIN to continue.
      </p>

      <% if (error) { %>
        <div class="flash flash-error">
          <%= error %>
        </div>
      <% } %>

      <form method="POST" action="/admin/login">

        <div class="field">
          <label for="pin">Admin PIN</label>

          <input
            type="password"
            id="pin"
            name="pin"
            inputmode="numeric"
            autocomplete="off"
            placeholder="Enter admin PIN"
            required
            autofocus
          />
        </div>

        <button type="submit" class="btn btn-primary">
          Enter Admin
        </button>

      </form>

    </div>

    <p class="admin-login-note">
      This area is private and only for the giveaway administrator.
    </p>

  </div>

</body>
</html>
