<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { pageTitle: 'Submissions — ' + giveaway.title }) %>

<body class="admin-body">

  <%- include('partials/nav') %>

  <div class="admin-wrap">

    <%- include('partials/flash') %>

    <a href="/admin/giveaways" class="admin-back-link">
      &larr; All giveaways
    </a>

    <h1><%= giveaway.title %></h1>

    <p class="admin-subtitle">
      <%= submissions.length %>
      submission<%= submissions.length === 1 ? '' : 's' %> received.
      Submitted data is only visible to signed-in administrators.
    </p>


    <% if (submissions.length === 0) { %>

      <div class="panel empty-state">
        <p>No submissions yet.</p>
      </div>

    <% } else { %>


      <% submissions.forEach(function(sub) { %>

        <div class="panel">

          <!-- STATUS + DATE -->
          <div class="admin-card-top">

            <div>

              <% if (sub.status === 'winner') { %>

                <span class="badge badge-winner">
                  🟢 SUCCESSFUL
                </span>

              <% } else if (sub.status === 'declined') { %>

                <span
                  class="badge"
                  style="background:#dc2626;color:white;"
                >
                  🔴 DECLINED
                </span>

              <% } else { %>

                <span
                  class="badge"
                  style="background:#eab308;color:#111;"
                >
                  🟡 PENDING
                </span>

              <% } %>

              <span class="admin-meta">
                <%= new Date(sub.createdAt).toLocaleString() %>
              </span>

            </div>

          </div>


          <!-- ALL SUBMITTED DATA -->
          <div style="margin-top:16px;">

            <% if (fields.length === 0) { %>

              <p>No fields configured for this giveaway.</p>

            <% } else { %>

              <% fields.forEach(function(field) { %>

                <div class="value-row">

                  <span class="label">
                    <%= field.label %>
                  </span>

                  <span class="value">
                    <%= sub.values[field.id] || '—' %>
                  </span>

                  <% if (sub.values[field.id]) { %>

                    <button
                      type="button"
                      class="copy-btn"
                      data-copy-value="<%= sub.values[field.id] %>"
                      onclick="
                        navigator.clipboard.writeText(this.dataset.copyValue);
                        this.textContent='Copied!';
                        setTimeout(() => this.textContent='Copy', 1200);
                      "
                    >
                      Copy
                    </button>

                  <% } %>

                </div>

              <% }); %>

            <% } %>

          </div>


          <!-- STATUS CONTROLS -->
          <div style="margin-top:18px;">

            <div style="margin-bottom:8px;font-weight:600;">
              Submission Status
            </div>

            <div
              style="
                display:flex;
                gap:8px;
                flex-wrap:wrap;
              "
            >

              <!-- PENDING -->
              <form
                method="POST"
                action="/admin/giveaways/<%= giveaway.id %>/submissions/<%= sub.id %>/status"
              >

                <input
                  type="hidden"
                  name="status"
                  value="pending"
                >

                <button
                  type="submit"
                  class="btn btn-secondary btn-small"
                >
                  🟡 Pending
                </button>

              </form>


              <!-- SUCCESSFUL / WINNER -->
              <form
                method="POST"
                action="/admin/giveaways/<%= giveaway.id %>/submissions/<%= sub.id %>/status"
              >

                <input
                  type="hidden"
                  name="status"
                  value="winner"
                >

                <button
                  type="submit"
                  class="btn btn-primary btn-small"
                >
                  🟢 Successful
                </button>

              </form>


              <!-- DECLINED -->
              <form
                method="POST"
                action="/admin/giveaways/<%= giveaway.id %>/submissions/<%= sub.id %>/status"
              >

                <input
                  type="hidden"
                  name="status"
                  value="declined"
                >

                <button
                  type="submit"
                  class="btn btn-small"
                  style="
                    background:#dc2626;
                    color:white;
                    border:none;
                  "
                >
                  🔴 Declined
                </button>

              </form>

            </div>

          </div>

        </div>

      <% }); %>

    <% } %>

  </div>

  <script src="/js/admin.js"></script>

</body>
</html>
