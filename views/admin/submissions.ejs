<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { pageTitle: 'Submissions — ' + giveaway.title }) %>

<body class="admin-body">

  <%- include('partials/nav') %>

  <div class="admin-wrap">

    <%- include('partials/flash') %>

    <a href="/admin/giveaways" class="admin-back-link">
      &larr; All giveaways
    </a>

    <h1><%= giveaway.title %></h1>

    <p class="admin-subtitle">
      <%= submissions.length %>
      submission<%= submissions.length === 1 ? '' : 's' %> received.
      Submitted data is only visible to signed-in administrators.
    </p>

    <div class="panel" style="margin-bottom:20px;">

      <div style="display:flex; gap:20px; flex-wrap:wrap;">

        <div>
          <div class="admin-meta">WINNER LIMIT</div>
          <strong>
            <%= giveaway.winnerCount || 1 %>
          </strong>
        </div>

        <div>
          <div class="admin-meta">SUCCESSFUL</div>
          <strong>
            <%= currentWinnerCount || 0 %>
          </strong>
        </div>

        <div>
          <div class="admin-meta">TOTAL SUBMISSIONS</div>
          <strong>
            <%= submissions.length %>
          </strong>
        </div>

      </div>

    </div>


    <% if (submissions.length === 0) { %>

      <div class="panel empty-state">
        <p>No submissions yet.</p>
      </div>

    <% } else { %>

      <% submissions.forEach(function(sub, index) { %>

        <div class="panel">

          <!-- STATUS + DATE -->
          <div class="admin-card-top">

            <div>

              <% if (sub.status === 'winner') { %>

                <span class="badge badge-winner">
                  🟢 SUCCESSFUL
                </span>

              <% } else { %>

                <span
                  class="badge"
                  style="background:#dc2626;color:white;"
                >
                  🔴 DECLINED
                </span>

              <% } %>

              <span class="admin-meta" style="margin-left:8px;">
                Submission #<%= index + 1 %>
              </span>

              <span class="admin-meta" style="margin-left:8px;">
                <%= new Date(sub.createdAt).toLocaleString() %>
              </span>

            </div>

          </div>


          <!-- ALL SUBMITTED DATA -->
          <div style="margin-top:16px;">

            <% if (fields.length === 0) { %>

              <p>No fields configured for this giveaway.</p>

            <% } else { %>

              <% fields.forEach(function(field) { %>

                <div class="value-row">

                  <span class="label">
                    <%= field.label %>
                  </span>

                  <span class="value">
                    <%= sub.values[field.id] || '—' %>
                  </span>

                  <% if (sub.values[field.id]) { %>

                    <button
                      type="button"
                      class="copy-btn"
                      data-copy-value="<%= sub.values[field.id] %>"
                      onclick="
                        navigator.clipboard.writeText(this.dataset.copyValue)
                          .then(() => {
                            this.textContent = 'Copied!';
                            setTimeout(() => this.textContent = 'Copy', 1200);
                          })
                          .catch(() => {
                            this.textContent = 'Copy failed';
                            setTimeout(() => this.textContent = 'Copy', 1200);
                          });
                      "
                    >
                      Copy
                    </button>

                  <% } %>

                </div>

              <% }); %>

            <% } %>

          </div>

        </div>

      <% }); %>

    <% } %>

  </div>

  <script src="/js/admin.js"></script>

</body>
</html>
